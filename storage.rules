rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Users can only access their own files, admins can access all
    match /users/{userId}/{allPaths=**} {
      // Allow read if authenticated and accessing own files, or if admin
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Allow write if authenticated, accessing own files, and file size is within limits
      allow write: if request.auth != null && (
        (request.auth.uid == userId && request.resource.size <= 10 * 1024 * 1024) ||
        isAdmin()
      );
      
      // Allow delete if authenticated and accessing own files, or if admin
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Specific rules for user profile photos (2MB max, any image filename)
    match /users/{userId}/profile/{photoFile} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (
        (request.auth.uid == userId &&
        request.resource.size <= 2 * 1024 * 1024 && // 2 MB max for profile photos
        request.resource.contentType.matches('image/.*')) || // Must be an image
        isAdmin()
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Specific rules for people profile photos (2MB max, any image filename)
    match /users/{userId}/people/{personId}/{photoFile} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (
        (request.auth.uid == userId &&
        request.resource.size <= 2 * 1024 * 1024 && // 2 MB max for profile photos
        request.resource.contentType.matches('image/.*')) || // Must be an image
        isAdmin()
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Specific rules for citation source files (10MB max, text/images/videos/audio)
    match /users/{userId}/sources/{sourceId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (
        (request.auth.uid == userId &&
        request.resource.size <= 10 * 1024 * 1024 && // 10 MB max for source files
        (request.resource.contentType.matches('text/.*') ||
         request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*') ||
         request.resource.contentType.matches('audio/.*') ||
         request.resource.contentType.matches('application/pdf'))) ||
        isAdmin()
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Rules for cookbook cover images (5MB max, images only)
    match /cookbooks/{cookbookId}/{fileName} {
      // Anyone authenticated can read cookbook images (ownership checked at Firestore level)
      allow read: if request.auth != null;
      
      // Allow write if authenticated, file is an image, and within size limit
      allow write: if request.auth != null && (
        (request.resource.size <= 5 * 1024 * 1024 && // 5 MB max
        request.resource.contentType.matches('image/.*')) ||
        isAdmin()
      );
      
      // Allow delete if authenticated (ownership checked at Firestore level)
      allow delete: if request.auth != null;
    }

    // Rules for recipe images (5MB max, images only)
    match /recipes/{recipeId}/{fileName} {
      // Anyone authenticated can read recipe images (ownership checked at Firestore level)
      allow read: if request.auth != null;
      
      // Allow write if authenticated, file is an image, and within size limit
      allow write: if request.auth != null && (
        (request.resource.size <= 5 * 1024 * 1024 && // 5 MB max
        request.resource.contentType.matches('image/.*')) ||
        isAdmin()
      );
      
      // Allow delete if authenticated (ownership checked at Firestore level)
      allow delete: if request.auth != null;
    }
  }
}
